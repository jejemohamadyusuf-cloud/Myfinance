{
  "version": 2,
  "outputDirectory": "public",
  "builds": [
    {
      "src": "api/index.php",
      "use": "vercel-php@0.7.2",
      "config": {
        "includeFiles": [
          "public/build/**",
          "public/build/manifest.json"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/build/(.*)",
      "dest": "/public/build/$1"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "(.*)",
      "dest": "/api/index.php"
    }
  ],
  "env": {
    "APP_URL": "https://myfinance-alpha-nine.vercel.app",
    "ASSET_URL": "https://myfinance-alpha-nine.vercel.app",
    "APP_DEBUG": "true",
    "VITE_MANIFEST_PATH": "public/build/manifest.json"
  }
}