{
  "version": 2,
  "builds": [
    {
      "src": "api/index.php",
      "use": "vercel-php@0.7.2"
    }
  ],
  "routes": [
    {
      "src": "/build/(.*)",
      "dest": "/build/$1"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "(.*)",
      "dest": "/api/index.php"
    }
  ],
  "env": {
    "APP_URL": "https://myfinance-alpha-nine.vercel.app",
    "ASSET_URL": "https://myfinance-alpha-nine.vercel.app",
    "APP_DEBUG": "true"
  }
}